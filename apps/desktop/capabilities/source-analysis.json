{
  "identifier": "source-analysis",
  "description": "The local main workbench can inspect and save sources, derive and review inert skills, compose inert skills from saved inputs, manage local backups and record deletion, and inspect inert engine status. Paths, SQL and engine requests are never accepted.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-select-and-analyze",
    "allow-list-snapshots",
    "allow-save-analysis",
    "allow-open-snapshot",
    "allow-read-composition-source",
    "allow-clear-analysis",
    "allow-get-engine-status",
    "allow-list-capabilities",
    "allow-open-capability",
    "allow-create-capability",
    "allow-revise-capability",
    "allow-review-capability",
    "allow-get-workspace-data",
    "allow-export-workspace-backup",
    "allow-prepare-workspace-restore",
    "allow-restore-workspace-backup",
    "allow-inspect-workspace-deletion",
    "allow-delete-workspace-record",
    "allow-preview-composition",
    "allow-commit-composition"
  ]
}
