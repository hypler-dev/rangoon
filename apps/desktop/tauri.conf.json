{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rangoon",
  "version": "0.1.0-dev",
  "identifier": "ai.rangoon.studio.dev",
  "build": {
    "frontendDist": "../../preview"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'",
      "capabilities": [
        "source-analysis",
        "model-confirmation",
        "cloud-model-confirmation",
        "cloud-credential-entry"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
